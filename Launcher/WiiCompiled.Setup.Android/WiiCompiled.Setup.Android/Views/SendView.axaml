<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WiiCompiled.Setup.Android.ViewModels"
             x:Class="WiiCompiled.Setup.Android.Views.SendView"
             x:DataType="vm:SendViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="18">
            <StackPanel Spacing="6">
                <TextBlock Text="Install to Device" FontSize="24" FontWeight="Bold" Foreground="#f3f5f8"/>
                <TextBlock Text="Installs the compiled APK directly onto your connected Android device over ADB."
                           TextWrapping="Wrap" Foreground="#8f99ab" FontSize="13" LineHeight="18"/>
            </StackPanel>

            <!-- Device Card -->
            <Border Background="#2a3040" CornerRadius="8" Padding="18,16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Target Android Device" FontSize="13" FontWeight="SemiBold" Foreground="#d2d9e5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Width="36" Height="32" Background="#384156" Foreground="#e1e7f0"
                                CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Refresh ADB devices and APK packages"
                                Command="{Binding RefreshEnvironmentCommand}">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    <ComboBox ItemsSource="{Binding ConnectedDevices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- APK Selection Card -->
            <Border Background="#242937" BorderBrush="#31394c" BorderThickness="1" CornerRadius="8" Padding="18,16">
                <StackPanel Spacing="10">
                    <TextBlock Text="Package to Install" FontSize="13" FontWeight="SemiBold" Foreground="#d2d9e5"/>

                    <ComboBox ItemsSource="{Binding AvailableApks}" SelectedItem="{Binding SelectedApk}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ApkOption">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#f3f5f8" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#8f99ab" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Status Indicator -->
            <Border Background="#1a1d26" CornerRadius="6" Padding="14,10">
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Medium" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Install Button -->
            <Button Classes="accent" Command="{Binding InstallToDeviceCommand}" IsEnabled="{Binding !IsInstalling}" HorizontalAlignment="Left" Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2M12 3v12m0 0l-4-4m4 4l4-4" Width="14" Height="14" Foreground="#ffffff" VerticalAlignment="Center"/>
                    <TextBlock Text="Install APK on Device" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>