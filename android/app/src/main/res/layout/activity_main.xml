<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Header Title with Status Badge on Upper Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_wheeldroid_header"
                android:contentDescription="WheelDroid App Icon"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WheelDroid"
                    android:textColor="@color/md_theme_dark_onBackground"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiiCompiled MKW Android Port"
                    android:textColor="@color/md_theme_dark_onSurfaceVariant"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Upper Right Ready / No Data Status Indicator -->
            <LinearLayout
                android:id="@+id/headerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_round_ctrl"
                android:backgroundTint="@color/status_ready_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/headerStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_check_circle"
                    android:contentDescription="Data Status Icon"
                    android:layout_marginEnd="5dp" />

                <TextView
                    android:id="@+id/headerStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready"
                    android:textColor="@color/status_ready"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Primary Action: Launch Game -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/launchBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:text="Launch Game"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="22dp"
            app:iconTint="@color/md_theme_dark_onPrimary"
            app:cornerRadius="18dp"
            android:enabled="false"
            app:backgroundTint="@color/md_theme_dark_primary"
            android:textColor="@color/md_theme_dark_onPrimary" />

        <!-- Category: Display & Performance (Collapsible) -->
        <LinearLayout
            android:id="@+id/headerGraphics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="6dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GRAPHICS &amp; ENGINE"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrowGraphics"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expand or Collapse Graphics"
                app:tint="@color/md_theme_dark_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGraphics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_dark_outlineVariant">

            <LinearLayout
                android:id="@+id/contentGraphics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <!-- Internal Resolution Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resolution"
                        android:textColor="@color/md_theme_dark_onSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerResolution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/md_theme_dark_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- 2-Column Row: Widescreen & Extend Cutout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <!-- Col 1: Widescreen -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Widescreen"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchWidescreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/md_theme_dark_outlineVariant" />

                    <!-- Col 2: Extend Cutout -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Extend Cutout"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchExtendToNotch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Skip Unready Pipelines Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Skip Unready Pipelines"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Eliminates shader compilation stutter"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSkipUnreadyPipelines"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Disable Copy Filter Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disable Copy Filter"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sharpens frame buffer clarity"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDisableCopyFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Disable Bloom Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disable Bloom (Faster)"
                        android:textColor="@color/md_theme_dark_onSurface"
                        android:textSize="15sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDisableBloom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Sustained Performance Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sustained Performance"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mitigates thermal throttling spikes"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSustainedPerf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Async Audio Mixing Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Async Audio Mixing"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Offloads sound mixer to worker core"
                            android:textColor="@color/md_theme_dark_onSurfaceVariant"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAudioMixer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category: Input Controls (Collapsible) -->
        <LinearLayout
            android:id="@+id/headerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="INPUT &amp; CONTROLS"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrowInput"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expand or Collapse Input Controls"
                app:tint="@color/md_theme_dark_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_dark_outlineVariant">

            <LinearLayout
                android:id="@+id/contentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <!-- 2-Column Row: Touch & Tilt Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <!-- Col 1: Touch Overlay -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Touch Overlay"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTouchControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/md_theme_dark_outlineVariant" />

                    <!-- Col 2: Tilt Steering -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tilt Steering"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTiltControls"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="true" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="2dp" />

                <!-- Controller Remap Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemapper"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="Gamepad &amp; Button Mapping"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_controller"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/md_theme_dark_secondary"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/md_theme_dark_outlineVariant"
                    android:textColor="@color/md_theme_dark_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        
        <!-- Category: Audio Volume & Controls (Collapsible) -->
        <LinearLayout
            android:id="@+id/headerAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AUDIO SETTINGS"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrowAudio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expand or Collapse Audio Settings"
                app:tint="@color/md_theme_dark_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_dark_outlineVariant">

            <LinearLayout
                android:id="@+id/contentAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <!-- Master Volume Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Master Volume"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textMasterVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMasterVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="5"
                        android:value="100"
                        app:thumbColor="@color/md_theme_dark_primary"
                        app:trackColorActive="@color/md_theme_dark_primary"
                        app:trackColorInactive="@color/md_theme_dark_surfaceContainerHighest" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="1dp" />

                <!-- Music Volume Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Music Volume"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textMusicVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMusicVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="5"
                        android:value="100"
                        app:thumbColor="@color/md_theme_dark_primary"
                        app:trackColorActive="@color/md_theme_dark_primary"
                        app:trackColorInactive="@color/md_theme_dark_surfaceContainerHighest" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="1dp" />

                <!-- Sound Effects Volume Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sound Effects Volume"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textSfxVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSfxVolume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="5"
                        android:value="100"
                        app:thumbColor="@color/md_theme_dark_primary"
                        app:trackColorActive="@color/md_theme_dark_primary"
                        app:trackColorInactive="@color/md_theme_dark_surfaceContainerHighest" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/md_theme_dark_outlineVariant"
                    android:layout_marginVertical="1dp" />

                <!-- Mute Audio Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mute All Audio"
                        android:textColor="@color/md_theme_dark_onSurface"
                        android:textSize="15sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAudioMuted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category: Game Features & Network (Collapsible) -->
        <LinearLayout
            android:id="@+id/headerFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FEATURES &amp; NETWORK"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrowFeatures"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expand or Collapse Features &amp; Network"
                app:tint="@color/md_theme_dark_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_dark_outlineVariant">

            <LinearLayout
                android:id="@+id/contentFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <!-- 2-Column Row: Vibration & FPS Counter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp">

                    <!-- Col 1: Vibration -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Vibration"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchRumble"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/md_theme_dark_outlineVariant" />

                    <!-- Col 2: FPS Counter -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="FPS"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFpsSettings"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="0dp"
                            app:icon="@drawable/ic_settings"
                            app:iconTint="@color/md_theme_dark_onSurfaceVariant"
                            app:iconSize="16dp"
                            android:contentDescription="Configure FPS Overlay Elements" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchShowFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleX="1.0"
                            android:scaleY="1.0"
                            android:checked="false" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category: Diagnostics & Data Management (Collapsible) -->
        <LinearLayout
            android:id="@+id/headerDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DATA &amp; DIAGNOSTICS"
                android:textColor="@color/md_theme_dark_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageView
                android:id="@+id/arrowDiagnostics"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="Expand or Collapse Diagnostics"
                app:tint="@color/md_theme_dark_primary" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/md_theme_dark_surfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/md_theme_dark_outlineVariant">

            <LinearLayout
                android:id="@+id/contentDiagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <!-- Side-by-side Clear Logs and Export Logs Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearLogs"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Clear Logs"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_delete_sweep"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="#E57373"
                        app:cornerRadius="14dp"
                        app:strokeColor="#8D6E63"
                        app:strokeWidth="1dp"
                        android:textColor="#FFA726" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/exportLogsBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Export Logs"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="16dp"
                        app:iconTint="#FFB74D"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/md_theme_dark_outlineVariant"
                        app:strokeWidth="1dp"
                        android:textColor="#FFB74D" />
                </LinearLayout>

                <!-- Wipe Save Data Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWipeSaveData"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Wipe Save Data (Fresh Run)"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_power_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="#BA68C8"
                    android:textColor="@color/md_theme_dark_onSurface"
                    app:strokeColor="@color/md_theme_dark_outline"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
