<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="20dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Controller Button Remapper"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any game action, then press the controller button you want to assign to it."
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/remapperContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#37474F"
            android:text="RESET TO DEFAULT CONTROLLER MAP"
            android:textColor="#ECEFF1"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveRemapper"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="#2E7D32"
            android:text="SAVE &amp; CLOSE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
